<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>Kreyo.VerifactuHashCalculator</PackageId>
    <Version>0.1.1</Version>
    <Authors>Kreyo</Authors>
    <Company>Kreyo</Company>
    <Description>Open-source reference implementation of the SHA-256 chained hash algorithm required by the Spanish Tax Agency (AEAT) for VeriFactu billing records.</Description>
    <PackageTags>verifactu;hash;aeat;spain;tax;billing</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/kreyo-io/verifactu-hash-calculator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kreyo-io/verifactu-hash-calculator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kreyo.VerifactuHashCalculator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
