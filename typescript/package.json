{
  "name": "@kreyo/verifactu-hash-calculator",
  "version": "0.1.2",
  "description": "Open-source reference implementation of the SHA-256 chained hash algorithm required by the Spanish Tax Agency (AEAT) for VeriFactu billing records.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "prebuild": "node -e \"require('fs').copyFileSync('../README.md','./README.md');require('fs').copyFileSync('../LICENSE','./LICENSE')\"",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "verifactu",
    "hash",
    "aeat",
    "spain",
    "spanish",
    "tax",
    "billing"
  ],
  "author": "Kreyo",
  "license": "MIT",
  "homepage": "https://github.com/kreyo-io/verifactu-hash-calculator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kreyo-io/verifactu-hash-calculator.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/kreyo-io/verifactu-hash-calculator/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
